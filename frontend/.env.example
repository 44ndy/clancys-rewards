# Copia este archivo como .env y completa los valores.
# El .env real nunca se sube al repositorio.
#
# Todo lo que empieza con EXPO_PUBLIC_ queda incrustado en el paquete de la app
# y es visible para cualquiera que la instale: aquí no van secretos.

# Dirección del backend. En desarrollo con un teléfono real tiene que ser la IP
# del PC en la Wi-Fi (no localhost), porque el teléfono resuelve localhost como
# sí mismo. Ejemplo: http://192.168.0.10:8001
EXPO_PUBLIC_BACKEND_URL=

# Client IDs de OAuth de Google, uno por plataforma. Vacíos dejan el botón de
# Google oculto; el login por correo sigue funcionando.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
