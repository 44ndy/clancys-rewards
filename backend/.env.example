# Copia este archivo como .env y completa los valores.
# El .env real nunca se sube al repositorio.

# --- Base de datos ---
# Cadena de conexión de MongoDB y nombre de la base.
MONGO_URL=
DB_NAME=

# --- Sesiones (JWT) ---
# JWT_SECRET firma los pases de sesión: una cadena larga y aleatoria, distinta
# en cada entorno. Si se filtra, cualquiera puede firmar sesiones válidas.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXP_DAYS=30

# --- Inicio de sesión con Google ---
# Client IDs de OAuth separados por coma (web, Android, iOS). Vacío deja el
# botón de Google oculto; el login por correo sigue funcionando.
GOOGLE_CLIENT_IDS=

# --- Orígenes permitidos (CORS) ---
# Qué orígenes de navegador pueden llamar a esta API, separados por coma y con
# el esquema incluido. Ejemplo: https://app.clancys.ie,http://localhost:8081
# No sirve poner "*": la app manda credenciales y el navegador rechaza el
# comodín en ese caso. Vacío = solo los servidores de desarrollo local.
CORS_ORIGINS=

# --- Notificaciones push ---
PUSH_BASE_URL=
PUSH_KEY=

# --- Cuentas iniciales del personal ---
# Solo se usan la primera vez que arranca el backend contra una base vacía, para
# crear las cuentas de dueño, encargado y mesero. Poné contraseñas largas: estas
# tres cuentas pueden gestionar el local entero.
SEED_OWNER_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_WAITER_PASSWORD=
